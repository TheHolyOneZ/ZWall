{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ZWall",
  "version": "0.1.0",
  "identifier": "eu.zsync.zwall",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ZWall",
        "width": 1180,
        "height": 760,
        "minWidth": 880,
        "minHeight": 600,
        "decorations": false,
        "transparent": true,
        "dragDropEnabled": true,
        "windowEffects": {
          "effects": [
            "acrylic"
          ]
        }
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost; font-src 'self' data:; connect-src ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$HOME/**",
          "$CACHE/**",
          "/tmp/**",
          "/mnt/**",
          "/media/**",
          "/run/media/**",
          "$PICTURE/**",
          "$VIDEO/**",
          "$DOWNLOAD/**",
          "$DESKTOP/**",
          "$DOCUMENT/**",
          "$LOCALDATA/**",
          "$DATA/**",
          "C:/**",
          "D:/**",
          "E:/**",
          "F:/**",
          "G:/**",
          "H:/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "appimage",
      "deb"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "category": "Graphics",
    "shortDescription": "Live wallpapers you can actually make",
    "externalBin": [],
    "linux": {
      "deb": {
        "depends": [
          "libmpv2"
        ]
      }
    }
  }
}
